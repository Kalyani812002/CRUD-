# Google OAuth 2.0 Web application client ID
# (Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application)
# Every frontend origin must be listed under "Authorized JavaScript origins":
#   http://localhost:5173          (local development)
#   https://<project>.vercel.app   (deployed frontend on Vercel)
VITE_GOOGLE_CLIENT_ID=

# API origin used by all task/user/auth API calls (e.g. https://crud-1-xp3y.onrender.com).
# Empty = same origin (Vite dev proxy forwards /api to the local backend).
VITE_API_URL=
