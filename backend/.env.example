PORT=3001
MONGODB_URI=mongodb+srv://kadamkalyani84_db_user:kalyani0812@cluster0.ngyssl7.mongodb.net/?appName=Cluster0

# Email notifications (optional). Leave SMTP_HOST empty to disable email;
# task CRUD always works without these.
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Daymark <no-reply@daymark.local>

# SMS notifications (optional). Disabled automatically when unset.
# Provider "webhook" (default) POSTs { to, message, from } as JSON to SMS_API_URL.
# Provider "twilio" uses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM instead.
SMS_ENABLED=true
SMS_PROVIDER=webhook
SMS_API_URL=
SMS_API_KEY=
SMS_API_HEADER=Authorization
SMS_API_PREFIX=Bearer
SMS_FROM=
SMS_DEFAULT_COUNTRY_CODE=+1
# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp notifications (optional). Disabled automatically when unset.
# Provider "webhook" (default) POSTs { to, message, from } as JSON to WHATSAPP_API_URL.
# Provider "meta" uses the WhatsApp Business Cloud API (requires WHATSAPP_PHONE_NUMBER_ID + WHATSAPP_TOKEN).
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=webhook
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_API_HEADER=Authorization
WHATSAPP_API_PREFIX=Bearer
WHATSAPP_FROM=
WHATSAPP_DEFAULT_COUNTRY_CODE=+1
# Meta Cloud API (WHATSAPP_PROVIDER=meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_URL=https://graph.facebook.com